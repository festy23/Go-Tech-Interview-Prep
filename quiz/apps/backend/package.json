{
  "name": "@quiz/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean --sourcemap && tsup --config tsup.serverless.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --tsconfig tsconfig.seed.json scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.5.0",
    "@quiz/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "arctic": "^3.7.0",
    "dotenv": "^16.5.0",
    "hono": "4.7.10",
    "mongodb": "^6.16.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  }
}
